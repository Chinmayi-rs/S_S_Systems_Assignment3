FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
PORT=8080
# GR-02: inactivity window and absolute token cap
# SESSION_IDLE_MINUTES=15
# JWT_MAX_HOURS=12
# GR-01: consecutive-failure lockout
# LOGIN_LOCKOUT_THRESHOLD=5
# LOGIN_LOCKOUT_MINUTES=15
# GR-13: encrypts the key that signs the published results. Keep it different from DELEGATE_KEY_SECRET.
RESULTS_KEY_SECRET=change-me-results
DELEGATE_KEY_SECRET=change-me-delegates
# SQLite files are the local default. GR-09 later swaps these for two Postgres URLs.
# IDENTITY_DATABASE_URL=sqlite:////absolute/path/identity.db
# BALLOT_DATABASE_URL=sqlite:////absolute/path/ballot.db
# GR-09 / GR-10 ballot keys. Generate with: python scripts/generate_ballot_keys.py
# Leave unset in development: keys are then created in instance/keys/ (git-ignored).
# BALLOT_ENC_KEY=
# BALLOT_TAG_KEY=
# BALLOT_SIGNING_KEY=
# BALLOT_KEY_DIR=/run/secrets/ballot
# GR-11 integrity scan interval in seconds (0 turns it off).
# INTEGRITY_SCAN_SECONDS=30

# GR-18: supply a Base64-encoded 32-byte encryption key.
# Generate locally using scripts/generate_pii_key.py.
# Load it into PowerShell before starting the application.
PII_ENCRYPTION_KEY=
